<!DOCTYPE html>
<html>
<head>
    <title>GroceryGo - Home</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <% include("partials/header") %>

    <main class="home-container">

        <section class="welcome">
            <h1>Welcome to GroceryGo 🛒</h1>
            <p>Your smart grocery shopping companion.</p>
        </section>

        <section class="main-options">

            <a href="/login" class="home-button">🔐 Login / Register</a>

            <a href="/shopping-list" class="home-button">📝 View Shopping List</a>

            <a href="/settings" class="home-button">⚙️ Settings</a>
        </section>

        <h2>Aisle Categories</h2>

        <section class="aisle-grid">

            <a href="/produce" class="aisle-card">🥕 Produce</a>
            <a href="/dairy" class="aisle-card">🧀 Dairy</a>
            <a href="/meat" class="aisle-card">🍖 Meat</a>
            <a href="/snacks" class="aisle-card">🍿 Snacks</a>
            <a href="/drinks" class="aisle-card">🥤 Drinks</a>
            <a href="/frozen" class="aisle-card">❄️ Frozen</a>
            <a href="/pantry" class="aisle-card">🥫 Pantry</a>

        </section>

    </main>

</body>
</html>


