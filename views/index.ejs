<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>GroceryGo</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="home-page">

    <!-- HEADER -->
    <header class="home-header">
        <h1>🥬 GroceryGo</h1>
        <p>Your smart grocery organizer</p>
    </header>

    <!-- NAVIGATION / CATEGORY GRID -->
    <section class="aisle-grid">

        <a href="/produce" class="aisle-card produce-card">
            <h2>🥕 Produce</h2>
        </a>

        <a href="/dairy" class="aisle-card dairy-card">
            <h2>🥛 Dairy</h2>
        </a>

        <a href="/meat" class="aisle-card meat-card">
            <h2>🍗 Meat</h2>
        </a>

        <a href="/snacks" class="aisle-card snacks-card">
            <h2>🍫 Snacks</h2>
        </a>

        <a href="/drinks" class="aisle-card drinks-card">
            <h2>🥤 Drinks</h2>
        </a>

        <a href="/frozen" class="aisle-card frozen-card">
            <h2>❄️ Frozen</h2>
        </a>

        <a href="/pantry" class="aisle-card pantry-card">
            <h2>🥫 Pantry</h2>
        </a>

    </section>

</body>
</html>
